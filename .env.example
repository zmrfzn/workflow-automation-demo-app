# Copy to .env, or run lab/wire-credentials.sh which writes it for you.
# Ingest license key: wires the APM agent in the shop-api image.
NEW_RELIC_LICENSE_KEY=
# User API key (NRAK-...): used by the controller for change-tracking markers.
NEW_RELIC_API_KEY=
NEW_RELIC_ACCOUNT_ID=
# Shared secret that Workflow Automation sends in the X-Rollback-Token header.
ROLLBACK_SECRET=

# pool-lab instructor-side configuration.
# Copy to pool-lab/.env (gitignored) and fill in.
# Load it with:  set -a; source pool-lab/.env; set +a

# ── Credentials ───────────────────────────────
# NerdGraph User API key (NRAK-...).
# Needs Organization Manager permissions and must belong to a user in the group named by LAB_ADMIN_GROUP_NAME.
# If unset, provision.sh falls back to the `newrelic` CLI profile (best effort, untested).
NEW_RELIC_API_KEY=NRAK-XXXX

# Region of the target org: US or EU.
NR_REGION=US

# Optional: override the NerdGraph endpoint entirely (wins over NR_REGION).
# NR_GRAPHQL_URL=https://api.newrelic.com/graphql

# ── Pool users ────────────────────────────────
# Pool user emails are "${POOL_EMAIL_PREFIX}NNN@${POOL_USER_DOMAIN}".
# Use plus-addressing so the invites land in a mailbox or group you control.
# The part before the "+" MUST be a real mailbox/group/alias you can read, or the invites bounce.
# Example: a Google Group labpool@example.com that you own gives
#   POOL_EMAIL_PREFIX=labpool+   and   POOL_USER_DOMAIN=example.com
# so the users are labpool+001@example.com ... and every invite lands in the group.
# TEST FIRST: send a mail to labpool+test@example.com and confirm it arrives before `users create`.
# Do not use the MARS prefix "mars+".
POOL_EMAIL_PREFIX=labpool+

# Required for `users create`, `users delete` and the browser commands (validate/reset). No default.
POOL_USER_DOMAIN=example.com

# How many pool users `users create` makes.
POOL_USER_COUNT=20

# Display name is "${POOL_USER_NAME_PREFIX} NNN".
POOL_USER_NAME_PREFIX="Lab User"

# Authentication domain that holds the pool users and groups.
POOL_AUTH_DOMAIN_NAME=Default

# ── Browser tooling (provision.sh users accept-invites | validate-passwords | reset-passwords) ──
# Shared password every pool user is expected to have (used by `users validate-passwords`).
# POOL_PASSWORD=

# Current shared password (used by `users reset-passwords`).
# POOL_CURRENT_PASSWORD=

# New shared password (used by `users reset-passwords`; `validate-passwords` falls back to it if POOL_PASSWORD is unset).
# POOL_NEW_PASSWORD=

# Invites JSON written from the Apps Script output (default: pool-lab/invites.json).
# POOL_INVITES_FILE=

# Python interpreter for the browser tooling (default: pool-lab/selenium/.venv/bin/python).
# POOL_LAB_PYTHON=

# ── Lab sub-accounts ──────────────────────────
# Sub-accounts are named "${LAB_ACCOUNT_PREFIX} NN"; groups are "<account name> - ReadOnly".
# The same LAB_ACCOUNT_PREFIX and POOL_EMAIL_PREFIX must also be set on the lab VM (see instruqt/config.snippet.yml).
LAB_ACCOUNT_PREFIX=INSTRUQT_LAB

# How many sub-accounts `accounts create` makes when no N is given.
LAB_ACCOUNT_COUNT=20

# Data region for new sub-accounts.
LAB_ACCOUNT_REGION=us01

# Existing group (must contain the API key's user) that is granted admin on each new account.
LAB_ADMIN_GROUP_NAME=Admin

# Role granted to LAB_ADMIN_GROUP_NAME on each account. Must allow license key creation.
LAB_ADMIN_ROLE=all_product_admin

# Role granted to each "<account> - ReadOnly" group.
LAB_READONLY_ROLE=read_only

# Propagation wait after granting the admin group access: POLLS x INTERVAL seconds (default 60 x 10 = 10 minutes).
LAB_PROPAGATION_POLLS=60
LAB_PROPAGATION_INTERVAL=10

# ── Lab VM only (set in the Instruqt track config.yml, not here) ──
# LAB_NR_API_KEY_SECRET   = NAME of the Instruqt secret holding the NerdGraph key
# LAB_USER_PASSWORD_SECRET = NAME of the Instruqt secret holding the shared pool-user password
